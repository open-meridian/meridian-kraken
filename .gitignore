# Python's leavings.
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# AGENTS.md, CLAUDE.md and .claude/ are committed with the plugin, so whoever
# works on it next, with whichever agent, gets the same instructions. What is
# one person's own is not: their notes, their settings, and what `meridian
# plugin dev` printed for them, which the loop keeps in .meridian/.
CLAUDE.local.md
.claude/settings.local.json
.meridian/

# Real recordings of Kraken's answers: never committed (Kraken asks its
# permission for non-personal use of its data; the plan's Q11).
# `make e2e-recorded RECORDED=<dir>` replays a directory kept outside the
# repository, or here.
recordings/

# What `make test`, `make preview` and `make e2e` leave behind.
.test.log
preview/
.e2e/
